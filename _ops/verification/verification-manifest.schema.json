{
  "$defs": {
    "activation": {
      "additionalProperties": false,
      "properties": {
        "full_profile": {
          "enum": [
            "decomposed",
            "preserved_aggregate"
          ]
        },
        "generation": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        },
        "lanes": {
          "items": false,
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/localLane"
            },
            {
              "$ref": "#/$defs/runnerlessLane"
            }
          ],
          "type": "array"
        }
      },
      "required": [
        "generation",
        "full_profile",
        "lanes"
      ],
      "type": "object"
    },
    "applicability": {
      "additionalProperties": false,
      "properties": {
        "lanes": {
          "items": {
            "enum": [
              "local",
              "runnerless_pr"
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "platforms": {
          "items": {
            "enum": [
              "darwin",
              "linux"
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "required_capabilities": {
          "items": {
            "$ref": "#/$defs/token"
          },
          "type": "array",
          "uniqueItems": true
        },
        "source_kinds": {
          "items": {
            "enum": [
              "commit",
              "pull_request",
              "staged_index"
            ]
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "lanes",
        "platforms",
        "source_kinds",
        "required_capabilities"
      ],
      "type": "object"
    },
    "costClass": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "memory_mib": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        },
        "output_bytes": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        },
        "pids": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        },
        "timeout_seconds": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "timeout_seconds",
        "memory_mib",
        "pids",
        "output_bytes"
      ],
      "type": "object"
    },
    "inertRule": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "matcher": {
          "$ref": "#/$defs/matcher"
        },
        "reason_code": {
          "const": "inert"
        }
      },
      "required": [
        "id",
        "matcher",
        "reason_code"
      ],
      "type": "object"
    },
    "inputRule": {
      "additionalProperties": false,
      "properties": {
        "classification_tags": {
          "items": {
            "$ref": "#/$defs/token"
          },
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "$ref": "#/$defs/token"
        },
        "matcher": {
          "$ref": "#/$defs/matcher"
        },
        "owner_obligation_ids": {
          "items": {
            "$ref": "#/$defs/token"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "matcher",
        "owner_obligation_ids",
        "classification_tags"
      ],
      "type": "object"
    },
    "localLane": {
      "additionalProperties": false,
      "properties": {
        "graduated_tags": {
          "items": {
            "$ref": "#/$defs/token"
          },
          "type": "array",
          "uniqueItems": true
        },
        "lane": {
          "const": "local"
        },
        "policy": {
          "enum": [
            "enforce",
            "shadow"
          ]
        }
      },
      "required": [
        "lane",
        "policy",
        "graduated_tags"
      ],
      "type": "object"
    },
    "matcher": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "exact",
            "prefix",
            "suffix"
          ]
        },
        "value_b64": {
          "$ref": "#/$defs/paddedBase64"
        }
      },
      "required": [
        "kind",
        "value_b64"
      ],
      "type": "object"
    },
    "obligation": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "$ref": "#/$defs/applicability"
        },
        "argv": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "cost_class": {
          "$ref": "#/$defs/token"
        },
        "cwd_b64": {
          "$ref": "#/$defs/paddedBase64"
        },
        "deep_only": {
          "type": "boolean"
        },
        "depends_on": {
          "items": {
            "$ref": "#/$defs/token"
          },
          "type": "array",
          "uniqueItems": true
        },
        "description": {
          "type": "string"
        },
        "eligible_in": {
          "items": {
            "$ref": "#/$defs/manifestMode"
          },
          "type": "array",
          "uniqueItems": true
        },
        "environment_allowlist": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "exclusive_group": {
          "anyOf": [
            {
              "$ref": "#/$defs/token"
            },
            {
              "type": "null"
            }
          ]
        },
        "execution_scope": {
          "enum": [
            "commit_snapshot",
            "host_read",
            "index_snapshot"
          ]
        },
        "hermeticity": {
          "enum": [
            "host_runtime",
            "pure",
            "temp_files",
            "temp_git"
          ]
        },
        "id": {
          "$ref": "#/$defs/token"
        },
        "network": {
          "enum": [
            "forbidden",
            "not_required"
          ]
        },
        "stdout_sentinel": {
          "type": [
            "string",
            "null"
          ]
        },
        "success_exit_codes": {
          "items": {
            "maximum": 9223372036854775807,
            "minimum": -9223372036854775808,
            "type": "integer"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "universal_in": {
          "items": {
            "$ref": "#/$defs/manifestMode"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "description",
        "argv",
        "cwd_b64",
        "depends_on",
        "universal_in",
        "eligible_in",
        "deep_only",
        "applicability",
        "cost_class",
        "execution_scope",
        "hermeticity",
        "exclusive_group",
        "network",
        "environment_allowlist",
        "success_exit_codes",
        "stdout_sentinel"
      ],
      "type": "object"
    },
    "paddedBase64": {
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "type": "string"
    },
    "pointerRule": {
      "additionalProperties": false,
      "properties": {
        "add_obligation_ids": {
          "items": {
            "$ref": "#/$defs/token"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "match": {
          "enum": [
            "descendant_prefix",
            "exact"
          ]
        },
        "pointer": {
          "type": "string"
        }
      },
      "required": [
        "pointer",
        "match",
        "add_obligation_ids"
      ],
      "type": "object"
    },
    "runnerlessLane": {
      "additionalProperties": false,
      "properties": {
        "graduated_tags": {
          "items": {
            "$ref": "#/$defs/token"
          },
          "type": "array",
          "uniqueItems": true
        },
        "lane": {
          "const": "runnerless_pr"
        },
        "policy": {
          "enum": [
            "enforce",
            "shadow"
          ]
        }
      },
      "required": [
        "lane",
        "policy",
        "graduated_tags"
      ],
      "type": "object"
    },
    "semanticSelector": {
      "additionalProperties": false,
      "properties": {
        "baseline_input_rule_ids": {
          "items": {
            "$ref": "#/$defs/token"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "$ref": "#/$defs/token"
        },
        "limits": {
          "additionalProperties": false,
          "properties": {
            "max_blob_bytes": {
              "const": 1048576
            },
            "max_changed_pointers": {
              "const": 10000
            },
            "max_depth": {
              "const": 64
            },
            "max_nodes": {
              "const": 100000
            },
            "max_number_chars": {
              "const": 128
            }
          },
          "required": [
            "max_blob_bytes",
            "max_depth",
            "max_nodes",
            "max_changed_pointers",
            "max_number_chars"
          ],
          "type": "object"
        },
        "parser": {
          "const": "json_pointer_changes_v1"
        },
        "pointer_rules": {
          "items": {
            "$ref": "#/$defs/pointerRule"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "baseline_input_rule_ids",
        "parser",
        "limits",
        "pointer_rules"
      ],
      "type": "object"
    },
    "sha256Id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "manifestMode": {
      "enum": [
        "deep_periodic",
        "focused_local",
        "focused_pr",
        "full",
        "full_release",
        "pre_commit"
      ]
    },
    "token": {
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation": {
      "$ref": "#/$defs/activation"
    },
    "cause_codes": {
      "items": {
        "enum": [
          "deep_mode",
          "dependency",
          "direct",
          "fallback",
          "full_mode",
          "inert",
          "not_applicable",
          "reverse_impact",
          "self_protection",
          "universal"
        ]
      },
      "maxItems": 10,
      "minItems": 10,
      "type": "array",
      "uniqueItems": true
    },
    "control_rule_ids": {
      "items": {
        "$ref": "#/$defs/token"
      },
      "type": "array",
      "uniqueItems": true
    },
    "cost_classes": {
      "items": {
        "$ref": "#/$defs/costClass"
      },
      "type": "array",
      "uniqueItems": true
    },
    "exclusive_groups": {
      "items": {
        "$ref": "#/$defs/token"
      },
      "type": "array",
      "uniqueItems": true
    },
    "inert_rules": {
      "items": {
        "$ref": "#/$defs/inertRule"
      },
      "type": "array",
      "uniqueItems": true
    },
    "input_rules": {
      "items": {
        "$ref": "#/$defs/inputRule"
      },
      "type": "array",
      "uniqueItems": true
    },
    "ledger_contract": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "dev-verification-rollout-ledger"
        },
        "schema_version": {
          "const": 1
        }
      },
      "required": [
        "schema",
        "schema_version"
      ],
      "type": "object"
    },
    "manifest_id": {
      "$ref": "#/$defs/sha256Id"
    },
    "manifest_version": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "type": "integer"
    },
    "modes": {
      "items": {
        "$ref": "#/$defs/manifestMode"
      },
      "maxItems": 6,
      "minItems": 6,
      "type": "array",
      "uniqueItems": true
    },
    "obligations": {
      "items": {
        "$ref": "#/$defs/obligation"
      },
      "type": "array",
      "uniqueItems": true
    },
    "receipt_contract": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "dev-verification-receipt"
        },
        "schema_version": {
          "const": 1
        }
      },
      "required": [
        "schema",
        "schema_version"
      ],
      "type": "object"
    },
    "repository_id": {
      "const": "KleinPerkins/dev"
    },
    "schema": {
      "const": "dev-verification-manifest"
    },
    "schema_version": {
      "const": 1
    },
    "selector_api_version": {
      "const": "1"
    },
    "semantic_selectors": {
      "items": {
        "$ref": "#/$defs/semanticSelector"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "schema_version",
    "manifest_id",
    "manifest_version",
    "repository_id",
    "selector_api_version",
    "receipt_contract",
    "ledger_contract",
    "modes",
    "cause_codes",
    "cost_classes",
    "exclusive_groups",
    "input_rules",
    "inert_rules",
    "semantic_selectors",
    "control_rule_ids",
    "obligations",
    "activation"
  ],
  "type": "object"
}
