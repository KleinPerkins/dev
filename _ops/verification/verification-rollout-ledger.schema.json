        "schema_version": {
          "const": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256Id"
        }
      },
      "required": [
        "schema",
        "schema_version",
        "sha256"
      ],
      "type": "object"
    },
    "schemaLinks": {
      "additionalProperties": false,
      "properties": {
        "ledger": {
          "$ref": "#/$defs/schemaLink"
        },
        "manifest": {
          "$ref": "#/$defs/schemaLink"
        },
        "receipt": {
          "$ref": "#/$defs/schemaLink"
        }
      },
      "required": [
        "manifest",
        "receipt",
        "ledger"
      ],
      "type": "object"
    },
    "sha256Id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "sourceBinding": {
