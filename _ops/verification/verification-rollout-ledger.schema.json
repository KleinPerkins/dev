            "properties": {
              "commit_sha": {
                "type": "null"
              },
              "head_commit_sha": {
                "type": "null"
              },
              "index_tree_sha": {
                "$ref": "#/$defs/commitSha"
              },
              "merge_base_sha": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_kind": {
                "const": "pull_request"
              }
            },
            "required": [
              "source_kind"
            ]
          },
          "then": {
            "properties": {
              "base_commit_sha": {
                "$ref": "#/$defs/commitSha"
              },
              "commit_sha": {
                "type": "null"
              },
              "head_commit_sha": {
                "$ref": "#/$defs/commitSha"
              },
              "index_tree_sha": {
                "type": "null"
              },
              "merge_base_sha": {
                "$ref": "#/$defs/commitSha"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_kind": {
                "const": "commit"
              }
            },
            "required": [
              "source_kind"
            ]
          },
          "then": {
            "properties": {
              "base_commit_sha": {
                "type": "null"
              },
              "commit_sha": {
                "$ref": "#/$defs/commitSha"
              },
              "head_commit_sha": {
                "type": "null"
              },
              "index_tree_sha": {
                "type": "null"
              },
              "merge_base_sha": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "base_commit_sha": {
          "$ref": "#/$defs/nullableCommitSha"
        },
        "candidate_tree_sha256": {
          "$ref": "#/$defs/sha256Id"
        },
        "commit_sha": {
          "$ref": "#/$defs/nullableCommitSha"
        },
        "head_commit_sha": {
          "$ref": "#/$defs/nullableCommitSha"
        },
        "index_tree_sha": {
          "$ref": "#/$defs/nullableCommitSha"
        },
