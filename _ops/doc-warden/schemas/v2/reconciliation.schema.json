{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {"type": ["string", "null"]},
    "classification": {"enum": ["conformant", "missing", "drifted", "dangling", "stale", "unmapped", "duplicate_authority", "plan_refinement_required", "operator_decision_required", "contradictory", "unverifiable"]},
    "code": {"minLength": 1, "type": "string"},
    "evidence": {"items": {"type": "string"}, "type": "array"},
    "repository_key": {"pattern": "^[0-9a-f-]{36}$", "type": "string"},
    "schema": {"const": "doc-warden/reconciliation/v2"},
    "source_revision": {"pattern": "^(no-head|[0-9a-f]{40})$", "type": "string"}
  },
  "required": ["schema", "repository_key", "source_revision", "classification", "code", "artifact_id", "evidence"],
  "type": "object"
}
