{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "classification": {"enum": ["creation_skeleton", "accepted_semantic", "unresolved_legacy_binding"]},
    "content_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "legacy_path": {"minLength": 1, "type": "string"},
    "legacy_schema": {"const": "doc-warden-receipt/v1"},
    "resolution": {"enum": ["adopted", "operator_decision_required"]},
    "schema": {"const": "doc-warden/migration-adoption/v2"},
    "source_revision": {"pattern": "^(no-head|[0-9a-f]{40})$", "type": "string"}
  },
  "required": ["schema", "legacy_schema", "legacy_path", "content_digest", "classification", "resolution", "source_revision"],
  "type": "object"
}
