{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "details": {"additionalProperties": true, "type": "object"},
    "event_id": {"pattern": "^[0-9a-f-]{36}$", "type": "string"},
    "operation_id": {"pattern": "^[0-9a-f-]{36}$", "type": "string"},
    "outcome": {"enum": ["applied", "refused", "partial"]},
    "prior_event_digest": {"anyOf": [{"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"}, {"type": "null"}]},
    "schema": {"const": "doc-warden/operation-event/v2"},
    "source_revision": {"pattern": "^(no-head|[0-9a-f]{40})$", "type": "string"},
    "transition": {"enum": ["creation_snapshot", "draft_update", "accepted_freeze", "roadmap_update", "projection_update", "migration_adoption", "supersession", "delivery_observed"]}
  },
  "required": ["schema", "event_id", "operation_id", "transition", "action_digest", "source_revision", "prior_event_digest", "outcome", "details"],
  "type": "object"
}
