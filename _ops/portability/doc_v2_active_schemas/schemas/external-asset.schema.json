{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonical_url": {"pattern": "^(https://.+|local:.+)$", "type": "string"},
    "captured_at": {"type": "string"},
    "egress_projection": {"const": "external_asset_pointer/v1"},
    "export_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "immutable_revision": {"minLength": 1, "type": "string"},
    "license": {"minLength": 1, "type": "string"},
    "owner": {"minLength": 1, "type": "string"},
    "provider": {"enum": ["figma", "quickhost", "local"]},
    "schema": {"const": "doc-warden/external-asset/v2"},
    "source_commit": {"anyOf": [{"pattern": "^[0-9a-f]{40}$", "type": "string"}, {"type": "null"}]},
    "source_github_repository_id": {"type": ["integer", "null"]},
    "source_path": {"type": ["string", "null"]},
    "source_repository_key": {"pattern": "^[0-9a-f-]{36}$", "type": "string"}
  },
  "required": ["schema", "provider", "canonical_url", "immutable_revision", "source_repository_key", "source_github_repository_id", "source_commit", "export_sha256", "captured_at", "owner", "license", "egress_projection"],
  "type": "object"
}
