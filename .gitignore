/_ops/baseline/state/
/_ops/baseline/profiles/pr-automation/state/
/_ops/interoperability/evidence/*
!/_ops/interoperability/evidence/codex-work-activation-bindings.json
/_ops/evidence/context-efficiency/
/_ops/reorg-v2/

# doc-warden v2 semantic records only; transient runtime/authoring state stays ignored.
!/.planning/
/.planning/*
!/.planning/doc-warden.json
!/.planning/artifacts/
/.planning/artifacts/*
!/.planning/artifacts/*.md
!/.planning/artifacts/*.governance.json
